# Canonical site URL used by the sitemap, RSS feed, and Open Graph tags.
# Overrides the url in content/profile.json (https://mezie.dev) when set.
# Leave unset locally. Set this to the production origin when you deploy.
# NEXT_PUBLIC_SITE_URL=https://mezie.dev

# Content adapter. local reads /content and needs no database.
# convex uses the optional Convex backend.
# custom loads src/lib/content/adapters/custom.ts (a SQL/ORM stub until you implement it).
CONTENT_SOURCE=local

# --- Convex (only when CONTENT_SOURCE=convex) ---
# From `npx convex dev`. Not required for local mode.
# NEXT_PUBLIC_CONVEX_URL=
# CONVEX_DEPLOYMENT=

# Opt in to the /admin CMS. Also set ADMIN_PASSWORD in the Convex dashboard.
# ADMIN_ENABLED=true

# --- Contact form (optional, Resend) ---
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=portfolio@example.com
# CONTACT_TO_EMAIL=chimezieinnocent39@gmail.com

# --- Analytics (optional) ---
# Script URL for a privacy-friendly tracker. Omit both to ship with no analytics.
# NEXT_PUBLIC_ANALYTICS_SRC=
# NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Extra https hostnames allowed for next/image, comma-separated.
# Defaults already include image.thum.io and pbs.twimg.com.
# Add your Convex storage host or object-storage host here. Do not commit a private hostname.
# IMAGE_REMOTE_HOSTS=image.thum.io,pbs.twimg.com,your-images.example.com

# Object storage used by the Convex admin uploader (optional).
# R2_BUCKET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
